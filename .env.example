TYPESAFE_API_KEY=
# Or route Jev (~typesafe/jev-latest) and every OpenRouter-hosted helper through one key.
OPENROUTER_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional System 2 reviewer, used only with Agent(..., reasoning=True). OpenAI-compatible.
REVIEW_MODEL_API_KEY=
REVIEW_MODEL_BASE_URL=https://openrouter.ai/api/v1
REVIEW_MODEL=deepseek/deepseek-v4.1-flash
REVIEW_MODEL_REASONING=medium
# Jev's own probability that a step needs System 2; review when it reaches this value.
REVIEW_THRESHOLD=0.5
REVIEW_TIMEOUT=10
# Hard cap on model calls per run (Jev + text helper + System 2).
JEV_MAX_CALLS=40
